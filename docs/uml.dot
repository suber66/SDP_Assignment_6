CityVisitor -> CityJsonExportVisitor [dir=back, arrowtail=empty, style=dashed];
AlertService -> InspectionVisitor [style=dashed, arrowhead=vee, label="creates per event", constraint=false, color="#c2410c", fontcolor="#9a3412", penwidth=1.8, tailport=w, headport=e];
AlertService -> District [arrowhead=vee, label="finds by districtId", constraint=false, color="#c2410c", fontcolor="#9a3412", penwidth=1.8, tailport=w, headport=e];
